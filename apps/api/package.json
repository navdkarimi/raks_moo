{
  "name": "@raqs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/app.test.ts test/auth.contract.test.ts",
    "test:integration": "tsx --test test/auth.integration.test.ts",
    "test:browser-server": "tsx test/fixtures/browser-server.ts"
  },
  "dependencies": {
    "@raqs/contracts": "0.1.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "mongoose": "^8.20.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0"
  }
}
